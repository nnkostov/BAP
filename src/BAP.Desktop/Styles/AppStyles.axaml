<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Surface palette — deep blue-black base -->
        <Color x:Key="BgBase">#0C0C1D</Color>
        <Color x:Key="BgPanel">#13132B</Color>
        <Color x:Key="BgCard">#1A1A36</Color>
        <Color x:Key="BgCardHover">#222244</Color>
        <Color x:Key="BgInput">#0F0F24</Color>
        <Color x:Key="BgToolbar">#0A0A18</Color>

        <!-- Accent -->
        <Color x:Key="AccentBlue">#5B8DEF</Color>
        <Color x:Key="AccentBlueHover">#729BF2</Color>
        <Color x:Key="AccentCyan">#22D3EE</Color>

        <!-- Semantic -->
        <Color x:Key="SemanticGreen">#10B981</Color>
        <Color x:Key="SemanticRed">#EF4444</Color>
        <Color x:Key="SemanticAmber">#FBBF24</Color>

        <!-- Text -->
        <Color x:Key="TextH">#E2E8F0</Color>
        <Color x:Key="TextBody">#94A3B8</Color>
        <Color x:Key="TextMuted">#475569</Color>

        <!-- Borders -->
        <Color x:Key="Border">#1E293B</Color>
        <Color x:Key="BorderLight">#334155</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
        <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}" />
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
        <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInput}" />
        <SolidColorBrush x:Key="BgToolbarBrush" Color="{StaticResource BgToolbar}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}" />
        <SolidColorBrush x:Key="SemanticGreenBrush" Color="{StaticResource SemanticGreen}" />
        <SolidColorBrush x:Key="SemanticRedBrush" Color="{StaticResource SemanticRed}" />
        <SolidColorBrush x:Key="SemanticAmberBrush" Color="{StaticResource SemanticAmber}" />
        <SolidColorBrush x:Key="TextHBrush" Color="{StaticResource TextH}" />
        <SolidColorBrush x:Key="TextBodyBrush" Color="{StaticResource TextBody}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    </Styles.Resources>

    <!-- ─── Button: accent (primary action) ─── -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background">
            <SolidColorBrush Color="{StaticResource AccentBlueHover}" />
        </Setter>
    </Style>

    <!-- ─── Button: danger ─── -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource SemanticRedBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ─── Button: ghost (subtle) ─── -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- ─── Button: toolbar (icon-like, minimal) ─── -->
    <Style Selector="Button.toolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
        <Setter Property="Background">
            <SolidColorBrush Color="#1E293B" />
        </Setter>
    </Style>

    <!-- ─── Panel header (with left accent stripe) ─── -->
    <Style Selector="Border.panel-header">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- ─── Card ─── -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ─── Status badge ─── -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

</Styles>
