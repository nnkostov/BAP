<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BAP.Desktop.ViewModels"
             x:Class="BAP.Desktop.Views.ConsoleView"
             x:DataType="vm:ConsoleViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Classes="ghost"
                        Command="{Binding ClearCommand}" FontSize="11" Padding="8,3" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="3" Height="14" CornerRadius="2"
                            Background="{StaticResource SemanticAmberBrush}" />
                    <TextBlock Text="CONSOLE" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextHBrush}"
                               LetterSpacing="1.5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log entries -->
        <ListBox ItemsSource="{Binding Entries}" Background="#08081A"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Padding="4,2">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ConsoleEntry">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,1">
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                   Foreground="#3D4663"
                                   FontFamily="Cascadia Mono,JetBrains Mono,Consolas,Courier New"
                                   FontSize="11" MinWidth="80" />
                        <TextBlock Text="{Binding LevelTag}" FontSize="10" FontWeight="Bold"
                                   FontFamily="Cascadia Mono,JetBrains Mono,Consolas,Courier New"
                                   MinWidth="32"
                                   Foreground="#586580" />
                        <TextBlock Text="{Binding Text}"
                                   Foreground="#8892B0"
                                   FontFamily="Cascadia Mono,JetBrains Mono,Consolas,Courier New"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
