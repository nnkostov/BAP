<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BAP.Desktop.ViewModels"
             x:Class="BAP.Desktop.Views.ProgramListView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Classes="section-header">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ Add Program" Classes="primary"
                        Command="{Binding AddProgramCommand}" />
                <StackPanel>
                    <TextBlock Text="Programs" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Create automation programs with event triggers and actions"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Panel Background="{StaticResource SurfaceMidBrush}">
            <!-- Empty State -->
            <StackPanel IsVisible="{Binding !Programs.Count}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="▶" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="No programs yet" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Click &quot;+ Add Program&quot; to create your first automation"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- Program List -->
            <ScrollViewer IsVisible="{Binding Programs.Count}">
                <ItemsControl ItemsSource="{Binding Programs}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ProgramViewModel">
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <!-- Program Header -->
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                            <Button Content="+ Event" Classes="ghost"
                                                    Command="{Binding AddEventCommand}"
                                                    FontSize="12" />
                                            <Button Content="{Binding IsRunning, FallbackValue='Start'}"
                                                    Command="{Binding ToggleRunningCommand}"
                                                    Classes="primary" FontSize="12" />
                                        </StackPanel>
                                        <TextBox Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                    </DockPanel>

                                    <!-- Events List -->
                                    <ItemsControl ItemsSource="{Binding Events}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:EventViewModel">
                                                <Border Margin="2" Padding="10,8" CornerRadius="6"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        Background="{StaticResource SurfaceMidBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{Binding TriggerDescription}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Text="→" FontSize="12"
                                                                   Foreground="{StaticResource AccentYellowBrush}"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Text="{Binding ActionDescription}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty events hint -->
                                    <TextBlock IsVisible="{Binding !Events.Count}"
                                               Text="No events — click &quot;+ Event&quot; to add a trigger"
                                               FontSize="12" FontStyle="Italic"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="4,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
