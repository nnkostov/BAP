<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BAP.Desktop.ViewModels"
             x:Class="BAP.Desktop.Views.ProgramListView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#E8E8E8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ Add Program"
                        Command="{Binding AddProgramCommand}" Margin="8,0,0,0" />
                <TextBlock Text="Programs" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Program List -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Programs}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProgramViewModel">
                        <Border Margin="4" Padding="12" CornerRadius="8"
                                BorderBrush="#CCCCCC" BorderThickness="1"
                                Background="#FAFAFA">
                            <StackPanel Spacing="8">
                                <!-- Program Header -->
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Add Event" Command="{Binding AddEventCommand}"
                                                FontSize="11" Padding="8,4" />
                                        <Button Content="{Binding IsRunning, FallbackValue='Start'}"
                                                Command="{Binding ToggleRunningCommand}"
                                                FontSize="11" Padding="8,4" />
                                    </StackPanel>
                                    <TextBox Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                             BorderThickness="0" Background="Transparent" />
                                </DockPanel>

                                <!-- Events List -->
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:EventViewModel">
                                            <Border Margin="2" Padding="8" CornerRadius="4"
                                                    BorderBrush="#EEE" BorderThickness="1"
                                                    Background="White">
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <TextBlock Text="{Binding TriggerDescription}"
                                                               FontSize="11" Foreground="Gray" />
                                                    <TextBlock Text="→" FontSize="11" />
                                                    <TextBlock Text="{Binding ActionDescription}"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
