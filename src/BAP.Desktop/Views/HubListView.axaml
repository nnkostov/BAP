<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BAP.Desktop.ViewModels"
             x:Class="BAP.Desktop.Views.HubListView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Classes="section-header">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Scan for Hubs" Classes="primary"
                        Command="{Binding ScanCommand}" />
                <StackPanel>
                    <TextBlock Text="Connected Hubs" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Manage your LEGO Powered Up, Boost, and other BLE hubs"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Panel Background="{StaticResource SurfaceMidBrush}">
            <!-- Empty State -->
            <StackPanel IsVisible="{Binding !Hubs.Count}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="⬡" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="No hubs connected" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Turn on your LEGO hub and click &quot;Scan for Hubs&quot; to connect"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- Hub Cards -->
            <ScrollViewer IsVisible="{Binding Hubs.Count}">
                <ItemsControl ItemsSource="{Binding Hubs}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:HubViewModel">
                            <Border Classes="card">
                                <StackPanel Spacing="12">
                                    <!-- Hub Header -->
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                            <Border Background="#33F5A623" CornerRadius="12" Padding="10,4">
                                                <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0:F0}%'}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentYellowBrush}" />
                                            </Border>
                                            <Button Content="Stop All" Classes="danger"
                                                    Command="{Binding StopAllCommand}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding TypeName}"
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                                <Border CornerRadius="8" Padding="8,2"
                                                        IsVisible="{Binding IsConnected}"
                                                        Background="#332ECC71">
                                                    <TextBlock Foreground="{StaticResource AccentGreenBrush}"
                                                               FontSize="11" FontWeight="SemiBold" Text="Connected" />
                                                </Border>
                                                <Border CornerRadius="8" Padding="8,2"
                                                        IsVisible="{Binding !IsConnected}"
                                                        Background="#33E74C3C">
                                                    <TextBlock Foreground="{StaticResource AccentRedBrush}"
                                                               FontSize="11" FontWeight="SemiBold" Text="Disconnected" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Separator -->
                                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" />

                                    <!-- Ports -->
                                    <ItemsControl ItemsSource="{Binding Ports}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:PortViewModel">
                                                <Border Margin="4" Padding="12" CornerRadius="8"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        Background="{StaticResource SurfaceMidBrush}"
                                                        IsVisible="{Binding HasUI}" MinWidth="140">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding Id, StringFormat='Port {0}'}"
                                                                   FontWeight="SemiBold" FontSize="12"
                                                                   Foreground="{StaticResource AccentYellowBrush}" />

                                                        <!-- Motor Control -->
                                                        <StackPanel IsVisible="{Binding IsMotor}" Spacing="6">
                                                            <Slider Minimum="-100" Maximum="100"
                                                                    Value="{Binding Speed}"
                                                                    Width="110"
                                                                    TickFrequency="10"
                                                                    IsSnapToTickEnabled="True" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Speed, StringFormat='Speed: {0}'}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                                <Button Content="Stop" Classes="ghost"
                                                                        Command="{Binding StopCommand}"
                                                                        FontSize="10" Padding="6,2" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Switch Control -->
                                                        <StackPanel IsVisible="{Binding IsSwitch}"
                                                                    Orientation="Horizontal" Spacing="6">
                                                            <Button Content="◄ Left" Classes="ghost"
                                                                    Command="{Binding SwitchLeftCommand}"
                                                                    FontSize="11" Padding="8,4" />
                                                            <Button Content="Right ►" Classes="ghost"
                                                                    Command="{Binding SwitchRightCommand}"
                                                                    FontSize="11" Padding="8,4" />
                                                        </StackPanel>

                                                        <!-- Sensor Display -->
                                                        <StackPanel IsVisible="{Binding IsSensor}" Spacing="4">
                                                            <TextBlock Text="{Binding ColorLabel, StringFormat='Color: {0}'}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Distance, StringFormat='Distance: {0}'}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>

                                                        <!-- Light Control -->
                                                        <StackPanel IsVisible="{Binding IsLight}" Spacing="4">
                                                            <Slider Minimum="0" Maximum="100"
                                                                    Value="{Binding Speed}"
                                                                    Width="110" />
                                                            <TextBlock Text="{Binding Speed, StringFormat='Brightness: {0}'}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
