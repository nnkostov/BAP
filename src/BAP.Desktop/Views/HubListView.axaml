<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BAP.Desktop.ViewModels"
             x:Class="BAP.Desktop.Views.HubListView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#E8E8E8">
            <TextBlock Text="Connected Hubs" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Hub Cards -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Hubs}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HubViewModel">
                        <Border Margin="4" Padding="12" CornerRadius="8"
                                BorderBrush="#CCCCCC" BorderThickness="1"
                                Background="#FAFAFA">
                            <StackPanel Spacing="8">
                                <!-- Hub Header -->
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0:F0}%'}"
                                                   VerticalAlignment="Center" Foreground="Gray" />
                                        <Button Content="Stop All" Command="{Binding StopAllCommand}"
                                                Background="#FFE0E0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding TypeName}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Foreground="Green" FontSize="11"
                                                       IsVisible="{Binding IsConnected}" Text="Connected" />
                                            <TextBlock Foreground="Red" FontSize="11"
                                                       IsVisible="{Binding !IsConnected}" Text="Disconnected" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Ports -->
                                <ItemsControl ItemsSource="{Binding Ports}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:PortViewModel">
                                            <Border Margin="4" Padding="8" CornerRadius="4"
                                                    BorderBrush="#DDD" BorderThickness="1"
                                                    IsVisible="{Binding HasUI}" MinWidth="120">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Id, StringFormat='Port {0}'}"
                                                               FontWeight="SemiBold" FontSize="11" />

                                                    <!-- Motor Control -->
                                                    <StackPanel IsVisible="{Binding IsMotor}" Spacing="4">
                                                        <Slider Minimum="-100" Maximum="100"
                                                                Value="{Binding Speed}"
                                                                Width="100"
                                                                TickFrequency="10"
                                                                IsSnapToTickEnabled="True" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Speed, StringFormat='Speed: {0}'}"
                                                                       FontSize="10" Foreground="Gray" />
                                                            <Button Content="Stop" Command="{Binding StopCommand}"
                                                                    FontSize="10" Padding="4,2" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Switch Control -->
                                                    <StackPanel IsVisible="{Binding IsSwitch}"
                                                                Orientation="Horizontal" Spacing="4">
                                                        <Button Content="Left" Command="{Binding SwitchLeftCommand}"
                                                                FontSize="10" Padding="8,4" />
                                                        <Button Content="Right" Command="{Binding SwitchRightCommand}"
                                                                FontSize="10" Padding="8,4" />
                                                    </StackPanel>

                                                    <!-- Sensor Display -->
                                                    <StackPanel IsVisible="{Binding IsSensor}" Spacing="2">
                                                        <TextBlock Text="{Binding ColorLabel, StringFormat='Color: {0}'}"
                                                                   FontSize="10" />
                                                        <TextBlock Text="{Binding Distance, StringFormat='Distance: {0}'}"
                                                                   FontSize="10" />
                                                    </StackPanel>

                                                    <!-- Light Control -->
                                                    <StackPanel IsVisible="{Binding IsLight}" Spacing="4">
                                                        <Slider Minimum="0" Maximum="100"
                                                                Value="{Binding Speed}"
                                                                Width="100" />
                                                        <TextBlock Text="{Binding Speed, StringFormat='Brightness: {0}'}"
                                                                   FontSize="10" Foreground="Gray" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
