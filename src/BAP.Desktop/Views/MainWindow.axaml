<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BAP.Desktop.ViewModels"
        xmlns:views="using:BAP.Desktop.Views"
        x:Class="BAP.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource SurfaceDarkBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Menu Bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceHeaderBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="4,2">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="_New Project" Command="{Binding NewProjectCommand}" />
                    <MenuItem Header="_Open Project" Command="{Binding LoadProjectCommand}" />
                    <MenuItem Header="_Save Project" Command="{Binding SaveProjectCommand}" />
                    <Separator />
                </MenuItem>
            </Menu>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceHeaderBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="status-dot" Fill="{StaticResource AccentBlueBrush}" />
                    <TextBlock Text="{Binding Hubs.Count, StringFormat='Hubs: {0}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="status-dot" Fill="{StaticResource AccentGreenBrush}" />
                    <TextBlock Text="{Binding Programs.Count, StringFormat='Programs: {0}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                    Padding="0" Margin="0">
            <!-- Hubs Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⬡" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Hubs" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:HubListView DataContext="{Binding}" />
            </TabItem>

            <!-- Programs Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="▶" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Programs" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:ProgramListView DataContext="{Binding}" />
            </TabItem>

            <!-- Console Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⌘" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Console" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:ConsoleView DataContext="{Binding Console}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
