<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BAP.Desktop.ViewModels"
        xmlns:views="using:BAP.Desktop.Views"
        x:Class="BAP.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource BgBaseBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding AddProgramCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding Console.ClearCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- ═══ Toolbar ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel>
                <!-- Right: project actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                    <Button Content="New" Classes="toolbar" Command="{Binding NewProjectCommand}" />
                    <Button Content="Open" Classes="toolbar" Command="{Binding LoadProjectCommand}" />
                    <Button Content="Save" Classes="toolbar" Command="{Binding SaveProjectCommand}" />
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,4" />
                    <TextBlock Text="v2.0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Left: app name -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="◆" FontSize="16" Foreground="{StaticResource AccentBlueBrush}" />
                    <TextBlock Text="Brick Automation Project" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextHBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Console (bottom, always visible) ═══ -->
        <Border DockPanel.Dock="Bottom" Height="160"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <views:ConsoleView DataContext="{Binding Console}" />
        </Border>

        <!-- ═══ Main content: Hubs (left) | Programs (right) ═══ -->
        <Grid ColumnDefinitions="*,1,*">
            <!-- Hubs panel -->
            <views:HubListView Grid.Column="0" DataContext="{Binding}" />

            <!-- Divider -->
            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <!-- Programs panel -->
            <views:ProgramListView Grid.Column="2" DataContext="{Binding}" />
        </Grid>
    </DockPanel>
</Window>
